<UserControl x:Class="Core.Launcher.ServersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Core.Launcher">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <local:InverseBooleanConverter x:Key="Not" />
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Host servers" IsChecked="{Binding Hosting}" VerticalAlignment="Center" />
            <TextBlock Text="Servers" Style="{StaticResource PageTitle}" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18" MaxWidth="760" HorizontalAlignment="Left"
                   Text="The launcher keeps these servers running so a free one is always ready for a match. A server that doesn't report ready in time, or stops, is started again." />

        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="18,12" Margin="0,0,0,18"
                Visibility="{Binding Hosting, Converter={StaticResource Visible}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="34" Height="32" Padding="0" Command="{Binding ChangeInstancesCommand}" CommandParameter="-1" ToolTip="One server fewer">
                        <TextBlock Text="&#xE738;" Style="{StaticResource Icon}" FontSize="11" />
                    </Button>
                    <TextBlock Text="{Binding Instances}" FontSize="16" FontWeight="SemiBold" Width="40" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Width="34" Height="32" Padding="0" Command="{Binding ChangeInstancesCommand}" CommandParameter="1" ToolTip="One server more">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" />
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Servers to keep running" FontSize="14" />
                    <TextBlock Text="Each one is a full game process, so more servers use more memory." Style="{StaticResource Subtle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Hosting, Converter={StaticResource Not}, ConverterParameter=Visibility}">
                <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="40" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Hosting is off" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                <TextBlock Text="Turn on Host servers to keep game servers ready for matches." Style="{StaticResource Muted}" HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Hosting, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding Servers}" Margin="0,0,-16,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Panel}" Width="340" Margin="0,0,16,16">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding State}" FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Instance, StringFormat=Server {0}}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Headline}" FontSize="14" Margin="0,14,0,0" TextWrapping="Wrap" />
                                    <ProgressBar IsIndeterminate="{Binding Booting}" Margin="0,10,0,0" Visibility="{Binding Booting, Converter={StaticResource Visible}}" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Subtle}" Margin="0,8,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Command="{Binding RestartCommand}" IsEnabled="{Binding CanRestart}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                                <TextBlock Text="Restart" />
                                            </StackPanel>
                                        </Button>
                                        <Button Margin="8,0,0,0" Command="{Binding ViewLogCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE9F9;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                                <TextBlock Text="View log" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
