<Window x:Class="Core.Launcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="820" Height="640" MinWidth="700" MinHeight="520"
        Style="{StaticResource WindowStyle}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Label" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Muted}">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="Builds">
                <Border Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Add build…" Command="{Binding AddBuildCommand}" />
                                <Button Content="Remove" Margin="6,0,0,0" Command="{Binding RemoveBuildCommand}" IsEnabled="{Binding HasBuild}" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Builds}" SelectedItem="{Binding SelectedBuild}" DisplayMemberPath="Name" />
                        </DockPanel>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasBuild, Converter={StaticResource Visible}}">
                            <StackPanel DataContext="{Binding SelectedBuild}">
                                <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Build folder (holds Engine and FortniteGame)" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Executable, relative to the build folder" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding ExecutableStatus}" Style="{StaticResource Hint}" />
                                <TextBlock Text="Client arguments" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding ClientArguments, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Server arguments" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding ServerArguments, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="The launcher adds -AUTH_LOGIN, -AUTH_PASSWORD and -AUTH_TYPE=epic itself, and -CoreBackend=http://127.0.0.1:&lt;port&gt; when CoreRedirect.dll is loaded." />
                                <CheckBox Content="Send HTTP through the backend with -httpproxy=127.0.0.1:&lt;port&gt;" IsChecked="{Binding UseHttpProxy}" Margin="0,12,0,0" />
                                <TextBlock Text="Client DLLs" Style="{StaticResource Label}" />
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="CoreRedirect.dll" IsChecked="{Binding ClientRedirect}" />
                                    <CheckBox Content="CoreClient.dll" IsChecked="{Binding ClientClient}" Margin="16,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="Server DLLs" Style="{StaticResource Label}" />
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="CoreRedirect.dll" IsChecked="{Binding ServerRedirect}" />
                                    <CheckBox Content="Core.dll" IsChecked="{Binding ServerServer}" Margin="16,0,0,0" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="DLLs load at process start, before WinMain, in this order: CoreRedirect, CoreClient, Core." />
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Grid.Column="2" TextWrapping="Wrap"
                                   Text="No builds yet. Add one by picking its folder; the launcher reads Engine\Build\Build.version.">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBuild}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="DLLs">
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <RadioButton Content="Latest GitHub release" IsChecked="{Binding UseRelease}" GroupName="DllSource" />
                        <TextBlock Text="Repository (owner/name)" Style="{StaticResource Label}" Margin="22,8,0,4" />
                        <TextBox Text="{Binding Settings.Dlls.Repository, UpdateSourceTrigger=PropertyChanged}" Margin="22,0,0,0" IsEnabled="{Binding UseRelease}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="22,3,0,0"
                                   Text="Core.dll, CoreClient.dll and CoreRedirect.dll are downloaded once per release and checked against the release's size and SHA-256." />
                        <RadioButton Content="Local folder" IsChecked="{Binding UseLocal}" GroupName="DllSource" Margin="0,18,0,0" />
                        <DockPanel Margin="22,8,0,0" IsEnabled="{Binding UseLocal}">
                            <Button Content="Browse…" DockPanel.Dock="Right" Margin="6,0,0,0" Command="{Binding BrowseLocalFolderCommand}" />
                            <TextBox Text="{Binding LocalFolder, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="22,3,0,0"
                                   Text="For example CoreV2\x64\Release. Each process gets a copy (with its .pdb), so you can rebuild while servers run; restarts pick up the new build." />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Backend">
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <RadioButton Content="Installed and updated by the launcher (recommended)" IsChecked="{Binding BackendManaged}" GroupName="BackendSource" />
                        <TextBlock Style="{StaticResource Hint}" Margin="22,3,0,0"
                                   Text="Core-Backend from its latest release (or its main branch until it has one), with its own Node.js. Accounts are kept across updates." />
                        <TextBlock Text="Repository (owner/name)" Style="{StaticResource Label}" Margin="22,8,0,4" />
                        <TextBox Text="{Binding Settings.Backend.Repository, UpdateSourceTrigger=PropertyChanged}" Margin="22,0,0,0" IsEnabled="{Binding BackendManaged}" />

                        <RadioButton Content="My Core-Backend folder" IsChecked="{Binding BackendFromFolder}" GroupName="BackendSource" Margin="0,16,0,0" />
                        <StackPanel Margin="22,0,0,0" IsEnabled="{Binding BackendFromFolder}">
                            <TextBlock Text="Folder (has src\main.js; run npm install there once)" Style="{StaticResource Label}" Margin="0,8,0,4" />
                            <DockPanel>
                                <Button Content="Browse…" DockPanel.Dock="Right" Margin="6,0,0,0" Command="{Binding BrowseBackendFolderCommand}" />
                                <TextBox Text="{Binding BackendFolder, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Text="Node.js" Style="{StaticResource Label}" Margin="0,8,0,4" />
                            <TextBox Text="{Binding Settings.Backend.Node, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <RadioButton Content="Already running (started outside the launcher)" IsChecked="{Binding BackendExternal}" GroupName="BackendSource" Margin="0,16,0,0" />
                        <TextBlock Text="Port" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Settings.Backend.Port, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Hint}" Text="0 lets the backend pick a free port." />
                        <TextBlock Text="Data folder" Style="{StaticResource Label}" />
                        <DockPanel>
                            <Button Content="Browse…" DockPanel.Dock="Right" Margin="6,0,0,0" Command="{Binding BrowseBackendDataFolderCommand}" />
                            <TextBox Text="{Binding BackendDataFolder, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Empty uses the launcher's Backend\data, or for your own folder its data folder (the one npm start uses)." />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Servers">
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <CheckBox Content="Host servers" IsChecked="{Binding Settings.Servers.Enabled}" />
                        <TextBlock Text="Servers to keep running" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Settings.Servers.Instances, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" />
                        <TextBlock Text="Ready timeout (seconds)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Settings.Servers.ReadyTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Hint}" Text="A server that hasn't logged &quot;Server ready&quot; by then is restarted. 0 waits forever." />
                        <TextBlock Text="Server login" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Settings.Servers.Login, UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Hint}" Text="{}{n} is the server's number, so each server logs in with its own account." />
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Content="Save" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" />
            </StackPanel>
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource BusyBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>
    </Grid>
</Window>
