<Window x:Class="Core.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Core.Launcher"
        Title="Core Launcher" Width="1180" Height="820" MinWidth="960" MinHeight="640"
        Style="{StaticResource WindowStyle}" WindowStartupLocation="CenterScreen" Icon="Assets/Core.ico">
    <Window.Resources>
        <local:PageConverter x:Key="Page" />
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,22,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,30">
                    <Image Source="{StaticResource LogoImage}" Width="32" Height="32" />
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CORE" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="Bold" />
                        <TextBlock Text="Launcher" Style="{StaticResource Subtle}" Margin="0,-3,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static local:MainViewModel.DiscordUrl}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8BD;" Style="{StaticResource Icon}" FontSize="13" Width="22" />
                            <TextBlock Text="Discord" Margin="8,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static local:MainViewModel.GitHubUrl}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE943;" Style="{StaticResource Icon}" FontSize="13" Width="22" />
                            <TextBlock Text="GitHub" Margin="8,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Version}" Style="{StaticResource Subtle}" Margin="12,10,0,0" />
                </StackPanel>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Home"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Page}, ConverterParameter=Home}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE968;" Content="Servers"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Page}, ConverterParameter=Servers}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9F9;" Content="Logs"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Page}, ConverterParameter=Logs}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Page}, ConverterParameter=Settings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="16,10" Margin="32,20,32,0" Visibility="{Binding HasUpdate, Converter={StaticResource Visible}}">
                <DockPanel>
                    <Button Content="Update" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding UpdateLauncherCommand}" />
                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding UpdateText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="32,22,32,24">
                <local:HomePage Visibility="{Binding CurrentPage, Converter={StaticResource Page}, ConverterParameter=Home}" />
                <local:ServersPage Visibility="{Binding CurrentPage, Converter={StaticResource Page}, ConverterParameter=Servers}" />
                <local:LogsPage Visibility="{Binding CurrentPage, Converter={StaticResource Page}, ConverterParameter=Logs}" />
                <local:SettingsPage DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Page}, ConverterParameter=Settings}" />
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" IsHitTestVisible="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                Padding="14,10" Margin="0,8,0,0" MaxWidth="420" HorizontalAlignment="Right">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black" />
                            </Border.Effect>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="370" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
