<UserControl x:Class="Core.Launcher.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Core.Launcher">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <local:InverseBooleanConverter x:Key="Not" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Home" Style="{StaticResource PageTitle}" Margin="0,0,0,18" />

            <Border CornerRadius="12" Background="{StaticResource HeroBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="28,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="FORTNITE BUILD" Style="{StaticResource Heading}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="260" ItemsSource="{Binding Builds}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedBuild}"
                                      IsEnabled="{Binding CanChangeBuild}" ToolTip="Close the game and turn hosting off to change the build" />
                            <TextBlock Text="{Binding BuildDetail}" Style="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="PLAY ON" Style="{StaticResource Heading}" Margin="0,22,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="260" ItemsSource="{Binding BackendChoices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedBackendChoice}"
                                      IsEnabled="{Binding AnyClientRunning, Converter={StaticResource Not}}"
                                      ToolTip="Your own backend, or a friend's you saved in Settings → Backend. Close the game to switch." />
                            <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding OpenSettingsTabCommand}" CommandParameter="2"
                                    ToolTip="Add a friend's backend (Settings → Backend)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Join a friend" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="PLAYING AS" Style="{StaticResource Heading}" Margin="0,22,0,6" />
                        <TextBox x:Name="PlayerName" Width="260" HorizontalAlignment="Left" FontSize="15"
                                 Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding ClientRunning, Converter={StaticResource Not}}" LostFocus="OnPlayerNameLostFocus">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding PlayCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,6">
                            <TextBlock Text="PASSWORD" Style="{StaticResource Heading}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource Subtle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <PasswordBox x:Name="Password" Width="260" HorizontalAlignment="Left" FontSize="15"
                                     IsEnabled="{Binding ClientRunning, Converter={StaticResource Not}}"
                                     PasswordChanged="OnPasswordChanged" LostFocus="OnPasswordLostFocus">
                            <PasswordBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding PlayCommand}" />
                            </PasswordBox.InputBindings>
                        </PasswordBox>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding RegisterCommand}">
                            <TextBlock Text="Need an account? Register" Foreground="{StaticResource AccentBrush}" />
                        </Button>
                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource BadBrush}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Width="250">
                        <Grid>
                            <Button Height="56" FontSize="17" Style="{StaticResource PrimaryButton}" Command="{Binding PlayCommand}"
                                    Visibility="{Binding ClientRunning, Converter={StaticResource Not}, ConverterParameter=Visibility}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Foreground="White" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding PlayLabel}" Foreground="White" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Height="56" FontSize="15" Command="{Binding PlayCommand}" Visibility="{Binding ClientRunning, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding PlayLabel}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ProgressBar IsIndeterminate="True" Margin="0,10,0,0" Visibility="{Binding Busy, Converter={StaticResource Visible}}" />
                        <Button Margin="0,10,0,0" Command="{Binding LaunchAnotherClientCommand}" Visibility="{Binding AnyClientRunning, Converter={StaticResource Visible}}"
                                ToolTip="Start one more game client, logged in with another username">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0" />
                                <TextBlock Text="Launch another client" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Panel}" Padding="16,12" Margin="0,14,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding StatusActionText}" Command="{Binding RunStatusActionCommand}"
                            Visibility="{Binding HasStatusAction, Converter={StaticResource Visible}}" />
                    <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14" Margin="0,0,12,0" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Panel}" Padding="16,12" Margin="0,14,0,0" Visibility="{Binding AnyClientRunning, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="RUNNING CLIENTS" Style="{StaticResource Heading}" />
                    <ItemsControl ItemsSource="{Binding Clients}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Command="{Binding ViewLogCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE9F9;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                                <TextBlock Text="View log" />
                                            </StackPanel>
                                        </Button>
                                        <Button Margin="8,0,0,0" Command="{Binding CloseCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0" />
                                                <TextBlock Text="Close" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource GoodBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Login}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Subtle}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <UniformGrid Columns="3" Margin="0,14,-14,0">
                <Button Style="{StaticResource TileButton}" Margin="0,0,14,0" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:LauncherPage.Servers}">
                    <StackPanel>
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Fill="{Binding ServersBrush}" />
                            <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="SERVERS" Style="{StaticResource Heading}" Margin="8,0,0,0" />
                        </DockPanel>
                        <TextBlock Text="{Binding ServersSummary}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,2" />
                        <TextBlock Text="{Binding ServersDetail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Margin="0,0,14,0" Command="{Binding OpenSettingsTabCommand}" CommandParameter="2">
                    <StackPanel>
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Fill="{Binding BackendBrush}" />
                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="CORE-BACKEND" Style="{StaticResource Heading}" Margin="8,0,0,0" />
                        </DockPanel>
                        <TextBlock Text="{Binding BackendSummary}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,2" />
                        <TextBlock Text="{Binding BackendDetail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BackendDetail}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Margin="0,0,14,0" Command="{Binding OpenSettingsTabCommand}" CommandParameter="1">
                    <StackPanel>
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Fill="{Binding DllBrush}" />
                            <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="CORE DLLS" Style="{StaticResource Heading}" Margin="8,0,0,0" />
                        </DockPanel>
                        <TextBlock Text="{Binding DllSummary}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,2" />
                        <TextBlock Text="{Binding DllDetail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DllDetail}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <DockPanel Margin="0,24,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:LauncherPage.Logs}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="All logs" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
                <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource Heading}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <Border Style="{StaticResource Panel}" Padding="16,12">
                <ItemsControl ItemsSource="{Binding Activity}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2" ToolTip="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
