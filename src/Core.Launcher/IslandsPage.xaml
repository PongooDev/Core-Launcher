<UserControl x:Class="Core.Launcher.IslandsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}" IsEnabled="{Binding Idle}" ToolTip="Read your islands from the backend again">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding ImportCommand}" IsEnabled="{Binding Idle}"
                        ToolTip="Make an island file someone shared a new island of yours, in your first free slot of its kind">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="Import island file…" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="Islands" Style="{StaticResource PageTitle}" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" MaxWidth="760" HorizontalAlignment="Left"
                   Text="Your Creative islands on the backend you play on. Export an island to a .coreisland file to share it, and import a file someone shared to play their island on this server: it becomes a new island in your first free slot of its kind. An island loads on the build it was saved on or a newer one." />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Description}" Style="{StaticResource Subtle}" Margin="0,0,0,18" />

        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="18,12" Margin="0,0,0,18" MaxWidth="760" HorizontalAlignment="Left"
                Visibility="{Binding HasError, Converter={StaticResource Visible}}">
            <DockPanel>
                <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" Foreground="{StaticResource BadBrush}" Margin="0,0,12,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource BadBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="18,12" Margin="0,0,0,18" MaxWidth="760" HorizontalAlignment="Left"
                Visibility="{Binding HasBuildNote, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding BuildNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="{Binding SlotsText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Margin="0,0,0,12"
                     Visibility="{Binding Loading, Converter={StaticResource Visible}}" />

        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasEmptyText, Converter={StaticResource Visible}}">
                <TextBlock Text="&#xE909;" Style="{StaticResource Icon}" FontSize="40" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="No islands yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Islands}" Margin="0,0,-16,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Panel}" Width="300" Margin="0,0,16,16">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding State}" FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="14" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasTitle, Converter={StaticResource Visible}}" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Subtle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}" ToolTip="Save this island as a .coreisland file to share it"
                                                ToolTipService.ShowOnDisabled="False">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                                <TextBlock Text="Export…" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
