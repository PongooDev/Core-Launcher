<Window x:Class="Core.Launcher.LocalHttpsPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local HTTPS" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        Style="{StaticResource WindowStyle}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/Core.ico">
    <StackPanel Margin="24,22,24,20">
        <TextBlock Text="Trust your local backend's certificate?" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="Message" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="7.00 and later open the V-Bucks purchase page at https://127.0.0.1, and its browser only accepts a certificate Windows trusts. The certificate covers only 127.0.0.1 and localhost, and it is your own backend's." />
        <CheckBox x:Name="DontAsk" Content="Don't ask again" Margin="0,16,0,0" />
        <TextBlock x:Name="Error" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Not now" IsCancel="True" />
            <Button x:Name="Enable" Margin="8,0,0,0" MinWidth="170" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnEnable">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="White" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Enable local HTTPS" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
